# ==========================================
# CẤU HÌNH SUPABASE (REQUIRED)
# ==========================================
# Lấy từ Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lấy từ Supabase Dashboard -> Project Settings -> Database
# DATABASE_URL dùng cho kết nối app/pooler (Port 6543, pgbouncer=true)
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL dùng cho Prisma/Migrations (Port 5432)
DIRECT_URL=postgresql://postgres.xxx:password@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# ==========================================
# CẤU HÌNH HỆ THỐNG / APP
# ==========================================
# Email admin chính của hệ thống
ADMIN_EMAIL=email@gmail.com

# ==========================================
# TÍCH HỢP BÊN THỨ 3 (Tùy chọn)
# ==========================================
# Resend API Key (Gửi email)
RESEND_API_KEY=re_your_resend_api_key


# FireCrawl & DeepSeek API (Thu thập dữ liệu tự động)
FIRECRAWL_API_KEY=your-firecrawl-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# ==========================================
# BẢO MẬT INGESTION ENGINE
# ==========================================
INGEST_API_BASE_URL=http://localhost:3000
INGEST_SECRET_KEY=1fashion_master_secret_2026
